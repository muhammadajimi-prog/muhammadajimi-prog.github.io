<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Portfolio</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:#0f172a;
      color:white;
      line-height:1.6;
    }

    header{
      height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:20px;
      background:linear-gradient(to right,#111827,#1e293b);
    }

    .hero h1{
      font-size:55px;
      margin-bottom:10px;
    }

    .hero p{
      font-size:20px;
      color:#cbd5e1;
      margin-bottom:20px;
    }

    .btn{
      display:inline-block;
      padding:12px 25px;
      background:#38bdf8;
      color:white;
      text-decoration:none;
      border-radius:8px;
      transition:0.3s;
    }

    .btn:hover{
      background:#0ea5e9;
    }

    section{
      padding:70px 10%;
    }

    h2{
      font-size:35px;
      margin-bottom:20px;
      color:#38bdf8;
    }

    .about p{
      max-width:700px;
      color:#cbd5e1;
    }

    .projects{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:20px;
    }

    .card{
      background:#1e293b;
      padding:20px;
      border-radius:12px;
      transition:0.3s;
    }

    .card:hover{
      transform:translateY(-5px);
    }

    .card h3{
      margin-bottom:10px;
      color:#38bdf8;
    }

    .skills-list{
      display:flex;
      flex-wrap:wrap;
      gap:15px;
    }

    .skill{
      background:#1e293b;
      padding:10px 20px;
      border-radius:8px;
    }

    footer{
      text-align:center;
      padding:20px;
      background:#111827;
      color:#94a3b8;
    }

    @media(max-width:768px){
      .hero h1{
        font-size:40px;
      }

      .hero p{
        font-size:18px;
      }
    }
  </style>
</head>

<body>

  <!-- HERO SECTION -->
  <header>
    <div class="hero">
      <h1>Hi, I'm Muhammad</h1>
      <p>Digital Creator • Affiliate Marketer • Content Strategist</p>
      <a href="#projects" class="btn">View My Work</a>
    </div>
  </header>

  <!-- ABOUT -->
  <section class="about">
    <h2>About Me</h2>
    <p>
      I am a passionate digital creator focused on affiliate marketing,
      content creation, YouTube growth, and online business strategies.
      I create engaging content and help people discover opportunities
      to earn online using modern digital tools.
    </p>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <h2>Projects</h2>

    <div class="projects">

      <div class="card">
        <h3>YouTube Automation</h3>
        <p>
          Built AI-powered YouTube content strategies with viral titles,
          captions, thumbnails, and SEO optimization.
        </p>
      </div>

      <div class="card">
        <h3>Affiliate Marketing</h3>
        <p>
          Promoted digital products using social media marketing,
          WhatsApp promotion, and content funnels.
        </p>
      </div>

      <div class="card">
        <h3>AI Video Content</h3>
        <p>
          Created short AI cinematic videos and animation prompts
          for TikTok, YouTube Shorts, and Instagram Reels.
        </p>
      </div>

      <div class="card">
        <h3>Brand Promotion</h3>
        <p>
          Designed engaging captions, marketing content,
          and audience growth strategies.
        </p>
      </div>

    </div>
  </section>

  <!-- SKILLS -->
  <section>
    <h2>Skills</h2>

    <div class="skills-list">
      <div class="skill">Affiliate Marketing</div>
      <div class="skill">Content Creation</div>
      <div class="skill">Video Editing</div>
      <div class="skill">YouTube SEO</div>
      <div class="skill">Digital Marketing</div>
      <div class="skill">Social Media Growth</div>
    </div>
  </section>

  <!-- CONTACT -->
  <section>
    <h2>t.me/EEYJII</h2>

    <p>Email: muhammadajimiyusufwasili@gmail.com</p>
    <p>WhatsApp: https://wa.me/qr/2DRVJRN3FNKYB1/p>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>© 2026 Muhammad Portfolio. All Rights Reserved.</p>
  </footer>

</body>
</html>